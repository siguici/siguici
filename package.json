{
  "name": "siguici",
  "description": "Sigui Kessé Emmanuel's personal monorepo",
  "engines": {
    "node": ">=24.17",
    "nub": ">=0.1"
  },
  "packageManager": "nub@0.1.4",
  "publishConfig": {
    "access": "public"
  },
  "private": true,
  "type": "module",
  "homepage": "https://siguici.deno.dev",
  "repository": "https://github.com/siguici/siguici",
  "scripts": {
    "build:app": "nub --cwd app run build",
    "build:doc": "nub --cwd doc run build",
    "check:app": "nub --cwd app run check",
    "check:doc": "nub --cwd doc run check",
    "check": "biome ci .",
    "check:format": "biome format .",
    "check:lint": "biome check .",
    "deploy": "deployctl deploy --project=siguici --no-static --include=./app/ ./app/out/server/entry.mjs",
    "dev:app": "nub --cwd app run dev",
    "dev:doc": "nub --cwd doc run dev",
    "fix": "nub run lint && nub run format",
    "fix:unsafe": "biome lint --write --unsafe",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "preview:app": "nub --cwd app run preview",
    "preview:doc": "nub --cwd doc run preview",
    "prod:app": "nub --cwd app run prod",
    "serve:app": "nub --cwd app run serve",
    "start:app": "nub --cwd app run start",
    "start:doc": "nub --cwd doc run start",
    "sync:app": "nub --cwd app run sync",
    "sync:doc": "nub --cwd doc run sync"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.1.4",
      "onFail": "warn"
    }
  },
  "workspaces": [
    "app/*",
    "doc"
  ],
  "allowBuilds": {
    "esbuild": true,
    "sharp": true
  }
}
