{
  "compilerOptions": {
    "strict": true,
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "test": { "include": ["tests/"], "exclude": ["out/"] },
  "tasks": {
    "dev": "deno run -A npm:astro dev",
    "build": "deno run -A npm:astro build",
    "check": "deno run -A npm:astro check"
    "serve": "deno run -A out/server/entry.mjs"
  },
  "imports": {
    "~/": "../",
    "@/": "./"
  }
}
