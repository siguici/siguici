{
  "license": "AGPL-3.0-or-later",
  "nodeModulesDir": "auto",
  "lock": true,
  "unstable": ["kv"],
  "allowScripts": ["npm:esbuild@0.27.7", "npm:sharp@0.34.5"],
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "test": { "include": ["tests/"], "exclude": ["out/"] },
  "tasks": {
    "dev": "deno run -A npm:astro dev",
    "build": "deno run -A npm:astro build",
    "check": "deno run -A npm:astro check"
    "serve": "deno run -A out/server/entry.mjs"
  },
  "imports": {
    "~/": "./",
    "@/": "./src/"
  }
  "exclude": [
    "**/dist/**",
    "**/.astro/**",
    "**/pagefind/**"
  ],
  "lint": {
    "rules": { "tags": ["recommended"] }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "tasks": {
    "build:app": "deno task --cwd app build",
    "build:doc": "deno task --cwd doc build",
    "check:app": "deno task --cwd app check",
    "check:doc": "deno task --cwd doc check",
    "check": "deno fmt --check && deno check --sloppy-imports && deno lint",
    "deploy": "deno deploy app --org=sigui --app=emmanuel --prod",
    "dev:app": "deno task --cwd app dev",
    "dev:doc": "deno task --cwd doc dev",
    "fix": "deno lint --fix && deno fmt",
    "preview:app": "deno task --cwd app preview",
    "preview:doc": "deno task --cwd doc preview",
    "prod:app": "deno task --cwd app prod",
    "serve:app": "deno task --cwd app serve",
    "start:app": "deno task --cwd app start",
    "start:doc": "deno task --cwd doc start",
    "sync:app": "deno task --cwd app sync",
    "sync:doc": "deno task --cwd doc sync"
  }
}
